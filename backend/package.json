{
  "name": "flight-booking-backend",
  "version": "1.0.0",
  "description": "Backend API for flight booking website using Node.js, Express and Supabase",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "nodemon",
    "start": "node src/server.js",
    "check": "npm run format:check && find src -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test": "node --test test/*.test.js",
    "format": "prettier --write 'src/**/*.js' 'test/**/*.js'",
    "format:check": "prettier --check 'src/**/*.js' 'test/**/*.js'"
  },
  "keywords": [
    "nodejs",
    "express",
    "supabase",
    "flight-booking"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fontsource/noto-sans": "5.3.0",
    "@supabase/supabase-js": "^2.45.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dayjs": "^1.11.12",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.1",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4",
    "redis": "^4.7.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prettier": "3.6.2"
  }
}
