NODE_ENV=development
PORT=5000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_READ_URL=
SUPABASE_READ_SERVICE_ROLE_KEY=
FRONTEND_URL=http://localhost:5173
TRUST_PROXY=false
BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT=100
PUBLIC_RATE_LIMIT=500
# Cash is always enabled. Add comma-separated online providers only after wiring their checkout adapters.
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
PAYMENT_CHECKOUT_API_URL=
BACKEND_PUBLIC_URL=http://localhost:5000
PAYMENT_WEBHOOK_SECRET=
PAYMENT_RETURN_URL=
PAYMENT_CANCEL_URL=
PAYMENT_REFUND_API_URL=
PAYMENT_REFUND_STATUS_API_URL=
PAYMENT_REQUEST_TIMEOUT_MS=10000
PAYMENT_WEBHOOK_REPLAY_WINDOW_SECONDS=300
# Direct VNPAY 2.1.0 integration. Keep VNPAY_HASH_SECRET server-only.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=http://localhost:5000/api/payments/vnpay/return
VNPAY_IPN_URL=
# Optional. Tickets remain downloadable when SMTP is not configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=VietFly <no-reply@vietfly.local>
REDIS_URL=redis://localhost:6379
FLIGHT_SEARCH_CACHE_TTL_SECONDS=15
SEAT_CLEANUP_INTERVAL_MS=60000
SCHEDULE_GENERATION_HORIZON_DAYS=90
SCHEDULE_GENERATION_INTERVAL_MS=86400000
OUTBOX_POLL_INTERVAL_MS=5000
REFUND_RECONCILIATION_INTERVAL_MS=60000
INVENTORY_RECONCILIATION_INTERVAL_MS=300000
INVENTORY_RECONCILIATION_AUTO_REPAIR=false
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REQUEST_TIMEOUT_MS=15000
